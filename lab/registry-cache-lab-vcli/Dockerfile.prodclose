# syntax=docker/dockerfile:1.7
# Lab-only mirror of ph-clint/docker/clint-agent/Dockerfile. Identical hoisted
# `pnpm add -g` resolution path as prod. Speed comes from the lab's warm
# registry caches (the edge + nginx docker volumes persist the npmjs-uplinked
# closure across runs), not from a build-side store cache: pnpm hardlinks the
# global node_modules from the store, so a BuildKit cache-mount store leaves the
# image with dangling hardlinks (the store inodes live on the ephemeral mount,
# not in the layer) — vetra-cli/dist/main.js then "Cannot find module" at run.
# Keep the store in the image layer, matching prod's Kaniko build.
#
# Build args mirror the prod ones. CLINT_REGISTRY is the lab nginx
# (http://localhost:5100 under --network host); it dual-uplinks the local
# origin for vetra-cli/vetra-app + the 4 ph-clint packages and real npmjs for
# the rest of the dependency closure.
ARG BASE_IMAGE=clint-runtime:labvcli
FROM ${BASE_IMAGE}

ARG CLINT_PACKAGE
ARG CLINT_VERSION
ARG CLINT_REGISTRY=http://localhost:5100

RUN test -n "${CLINT_PACKAGE}" || (echo "CLINT_PACKAGE build-arg is required" >&2; exit 1) \
 && test -n "${CLINT_VERSION}" || (echo "CLINT_VERSION build-arg is required" >&2; exit 1)

# Byte-identical to prod's command.
RUN pnpm add -g "${CLINT_PACKAGE}@${CLINT_VERSION}" \
      --registry "${CLINT_REGISTRY}" \
      --config.blockExoticSubdeps=false

LABEL io.vetra.clint.package="${CLINT_PACKAGE}" \
      io.vetra.clint.version="${CLINT_VERSION}"
