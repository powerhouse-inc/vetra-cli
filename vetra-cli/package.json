{
  "name": "vetra-cli",
  "version": "0.0.1-dev.27",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.dev.vetra.io"
  },
  "type": "module",
  "bin": {
    "vetra": "./dist/main.js"
  },
  "files": [
    "dist",
    "Dockerfile"
  ],
  "scripts": {
    "build:assets": "tsx scripts/build-assets.ts",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && pnpm build:assets && pnpm typecheck && tsdown",
    "refresh:test-skills": "pnpm build:assets && rm -rf ../../vetra-test/.ph/vetra/.mastra/skills && cp -R gen/skills ../../vetra-test/.ph/vetra/.mastra/skills && echo '[refresh] vetra-test skills replaced; restart vetra for the change to take effect'",
    "dev": "tsx src/main.ts --workdir ../../vetra-test",
    "dev:reset": "bash scripts/dev-reset.sh",
    "start": "node dist/main.js --workdir ../../vetra-test",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --detectOpenHandles",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --collectCoverageFrom='src/**/*.ts'",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "lint": "eslint src tests",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "mastra:start": "mastra start",
    "telemetry:dev": "ph-telemetry-dev --cli-name=vetra"
  },
  "dependencies": {
    "@datadog/pprof": "^5.13.3",
    "@electric-sql/pglite": "^0.3.15",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.205.0",
    "@opentelemetry/core": "2.1.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.205.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.205.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.205.0",
    "@opentelemetry/instrumentation": "0.205.0",
    "@opentelemetry/instrumentation-ioredis": "0.47.1",
    "@opentelemetry/resource-detector-alibaba-cloud": "0.30.1",
    "@opentelemetry/resource-detector-aws": "1.12.0",
    "@opentelemetry/resource-detector-azure": "0.6.1",
    "@opentelemetry/resource-detector-gcp": "0.33.1",
    "@opentelemetry/resources": "2.1.0",
    "@opentelemetry/sdk-logs": "0.205.0",
    "@opentelemetry/sdk-metrics": "2.1.0",
    "@opentelemetry/sdk-node": "0.205.0",
    "@opentelemetry/sdk-trace-base": "2.1.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@powerhousedao/pglite-fs": "catalog:",
    "@powerhousedao/switchboard": "catalog:",
    "devcert": "1.2.3",
    "graphql": "catalog:",
    "libsql": "^0.5.29",
    "vetra-app": "workspace:*"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^2.0.80",
    "@jest/globals": "^30.2.0",
    "@mastra/core": "^1.41.0",
    "@mastra/libsql": "^1.12.1",
    "@mastra/mcp": "^1.9.1",
    "@mastra/memory": "^1.20.2",
    "@playwright/test": "^1.61.0",
    "@powerhousedao/clint-common": "catalog:",
    "@powerhousedao/ph-clint": "catalog:",
    "@powerhousedao/ph-clint-claude-subscription": "0.1.0-dev.1",
    "@powerhousedao/ph-clint-dev": "catalog:",
    "@powerhousedao/ph-clint-observability": "catalog:",
    "@powerhousedao/reactor": "catalog:",
    "@powerhousedao/reactor-api": "catalog:",
    "@powerhousedao/reactor-attachments": "catalog:",
    "@powerhousedao/reactor-browser": "catalog:",
    "@powerhousedao/shared": "catalog:",
    "@powerhousedao/vetra": "catalog:",
    "@powerhousedao/vetra-cloud-client": "workspace:*",
    "@renown/sdk": "catalog:",
    "@toon-format/toon": "^2.2.0",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "chokidar": "^3.6.0",
    "document-model": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^30.2.0",
    "jsonpath-plus": "^10.4.0",
    "kysely": "^0.27.0",
    "kysely-pglite-dialect": "^1.2.0",
    "proper-lockfile": "^4.1.2",
    "ts-jest": "^29.4.6",
    "tsdown": "^0.21.1",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
