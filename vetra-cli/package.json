{
  "name": "vetra-cli",
  "version": "0.0.1-dev.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "vetra": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:assets": "tsx scripts/build-assets.ts",
    "build": "pnpm build:assets && tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --detectOpenHandles",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --collectCoverageFrom='src/**/*.ts'",
    "lint": "eslint src tests",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "mastra:start": "mastra start",
    "telemetry:dev": "ph-telemetry-dev --cli-name=vetra"
  },
  "dependencies": {
    "@mastra/core": "~1.32.0",
    "@mastra/libsql": "~1.10.1",
    "@mastra/mcp": "^1.4.1",
    "@mastra/memory": "^1.13.1",
    "@powerhousedao/clint-common": "0.1.0-dev.76",
    "@powerhousedao/codegen": "6.0.0-dev.239",
    "@powerhousedao/ph-clint": "0.1.0-dev.76",
    "@powerhousedao/ph-clint-observability": "0.1.0-dev.76",
    "@powerhousedao/reactor": "6.0.0-dev.239",
    "@powerhousedao/reactor-api": "6.0.0-dev.239",
    "@powerhousedao/registry": "6.0.0-dev.253",
    "@powerhousedao/shared": "6.0.0-dev.253",
    "@powerhousedao/switchboard": "6.0.0-dev.253",
    "@powerhousedao/vetra": "6.0.0-dev.253",
    "@toon-format/toon": "^2.2.0",
    "document-model": "6.0.0-dev.239",
    "jsonpath-plus": "^10.4.0",
    "vetra-app": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@powerhousedao/ph-clint-dev": "0.1.0-dev.76",
    "@types/node": "^25.5.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.33.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
