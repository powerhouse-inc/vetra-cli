{
  "type": "clint-project",
  "features": {
    "agent": {
      "id": "vetra-agent",
      "name": "Vetra Agent",
      "description": null,
      "image": "data:image/svg+xml;base64,",
      "models": [
        {
          "id": "anthropic/claude-sonnet-4-5"
        }
      ]
    },
    "powerhouse": {
      "support": "Connect",
      "package": "vetra-app"
    },
    "observability": {
      "enabled": true,
      "package": "@powerhousedao/ph-clint-observability",
      "envVars": {
        "sentryDsn": "VETRA_SENTRY_DSN",
        "otelExporterOtlpEndpoint": "VETRA_OTEL_EXPORTER_OTLP_ENDPOINT",
        "telemetryConsent": "VETRA_OBSERVABILITY_CONSENT"
      }
    }
  },
  "serviceCommand": "vetra",
  "proxyEnabled": true,
  "supportedResources": [
      "vetra-agent-xl",
      "vetra-agent-xxl"
  ],
  "config": [
    {
      "name": "ANTHROPIC_API_KEY",
      "type": "secret",
      "description": "Anthropic Claude API key.",
      "required": true
    },
    {
      "name": "VETRA_ANTHROPIC_API_KEY",
      "type": "secret",
      "description": "Anthropic Claude API key.",
      "required": true
    },
    {
      "name": "VETRA_CLI_ANTHROPIC_API_KEY",
      "type": "secret",
      "description": "Anthropic Claude API key.",
      "required": true
    },
    {
      "name": "VETRA_SENTRY_DSN",
      "type": "secret",
      "description": "Sentry DSN.",
      "required": false
    },
    {
      "name": "VETRA_OTEL_EXPORTER_OTLP_ENDPOINT",
      "type": "secret",
      "description": "OpenTelemetry exporter OTLP endpoint.",
      "required": false
    },
    {
      "name": "VETRA_OBSERVABILITY_CONSENT",
      "type": "secret",
      "description": "Pre-set telemetry consent ('granted' or 'denied') to skip the interactive prompt on non-interactive/deployed runs.",
      "required": false
    }
  ]
}
