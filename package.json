{
  "name": "@powerhousedao/vetra-cli",
  "version": "6.4.0-next.6",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerhouse-inc/vetra-cli.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist",
    "/bin",
    "/hosts"
  ],
  "bin": {
    "vetra": "./bin/vetra.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/browser/index.js",
      "node": "./dist/node/index.mjs"
    },
    "./document-models": {
      "types": "./dist/types/document-models/index.d.ts",
      "browser": "./dist/browser/document-models/index.js",
      "node": "./dist/node/document-models/index.mjs"
    },
    "./document-models/*": {
      "types": "./dist/types/document-models/*/index.d.ts",
      "browser": "./dist/browser/document-models/*/index.js",
      "node": "./dist/node/document-models/*/index.mjs"
    },
    "./editors": {
      "types": "./dist/types/editors/index.d.ts",
      "browser": "./dist/browser/editors/index.js",
      "node": "./dist/node/editors/index.mjs"
    },
    "./editors/*": {
      "types": "./dist/types/editors/*/module.d.ts",
      "browser": "./dist/browser/editors/*/module.js"
    },
    "./subgraphs": {
      "types": "./dist/types/subgraphs/index.d.ts",
      "node": "./dist/node/subgraphs/index.mjs"
    },
    "./processors": {
      "types": "./dist/types/processors/index.d.ts",
      "browser": "./dist/browser/processors/index.js",
      "node": "./dist/node/processors/index.mjs"
    },
    "./cli": {
      "types": "./dist/types/cli/index.d.ts",
      "node": "./dist/node/cli/index.mjs"
    },
    "./manifest": "./dist/powerhouse.manifest.json",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "tsx cli/scripts/build-assets.ts && ph-cli build && ph-cli run cli build",
    "build:connect": "ph-cli connect build && tsx cli/scripts/pin-connect-layer.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false && tsc -p hosts",
    "tsc": "tsc",
    "tsc:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config cli/e2e/playwright.config.ts",
    "test:e2e:preview": "playwright test --config cli/e2e/preview-editors/playwright.config.ts",
    "test:e2e:install": "node -e \"process.env.PLAYWRIGHT_SKIP_BROWSER_GC='1';process.argv.splice(1,0,'playwright','install','chromium');require('@playwright/test/cli')\"",
    "test:e2e:report": "playwright show-report cli/e2e/playwright-report",
    "lint": "eslint --config eslint.config.js --cache --cache-strategy content",
    "lint:fix": "npm run lint -- --fix",
    "check-circular-imports": "npx dpdm -T ./index.ts",
    "generate": "ph-cli generate",
    "dev": "tsx cli/src/main.ts --workdir ../vetra-test",
    "dev:reset": "tsx cli/scripts/dev-reset.ts"
  },
  "peerDependencies": {
    "@powerhousedao/clint": "catalog:",
    "@powerhousedao/host-core": "catalog:",
    "@powerhousedao/ph-cli": "catalog:",
    "@powerhousedao/reactor-api": "catalog:",
    "@powerhousedao/reactor-browser": "catalog:",
    "@powerhousedao/switchboard": "catalog:",
    "document-model": "catalog:",
    "graphql": "^16",
    "graphql-tag": "^2",
    "react": "^19",
    "react-dom": "^19",
    "vite": "^8.0.0",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@graphql-codegen/add": "6.0.0",
    "@graphql-codegen/cli": "6.1.1",
    "@graphql-codegen/typescript": "5.0.7",
    "@graphql-tools/merge": "9.1.7",
    "@mastra/core": "catalog:",
    "@mastra/libsql": "catalog:",
    "@mastra/mcp": "catalog:",
    "@mastra/memory": "catalog:",
    "@openrouter/ai-sdk-provider": "1.5.4",
    "@powerhousedao/clint-common": "catalog:",
    "@powerhousedao/shared": "catalog:",
    "@powerhousedao/vetra": "catalog:",
    "@renown/sdk": "catalog:",
    "@toon-format/toon": "^2.2.0",
    "change-case": "5.4.4",
    "fflate": "^0.8.2",
    "graphql-codegen-typescript-validation-schema": "0.18.1",
    "jsonpath-plus": "^10.4.0",
    "load-json-file": "^7.0.1",
    "lucide-react": "^1.17.0",
    "oxfmt": "0.68.0",
    "proper-lockfile": "^4.1.2",
    "read-pkg": "10.1.0",
    "remeda": "2.33.7",
    "ts-morph": "27.0.2",
    "write-package": "7.2.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^2.0.80",
    "@electric-sql/pglite": "0.3.15",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.61.0",
    "@powerhousedao/clint": "catalog:",
    "@powerhousedao/connect": "catalog:",
    "@powerhousedao/design-system": "catalog:",
    "@powerhousedao/document-engineering": "1.40.5",
    "@powerhousedao/host-core": "catalog:",
    "@powerhousedao/ph-cli": "catalog:",
    "@powerhousedao/powerhouse-vetra-packages": "catalog:",
    "@powerhousedao/reactor": "catalog:",
    "@powerhousedao/reactor-api": "catalog:",
    "@powerhousedao/reactor-attachments": "catalog:",
    "@powerhousedao/reactor-browser": "catalog:",
    "@powerhousedao/switchboard": "catalog:",
    "@powerhousedao/vetra-cloud-package": "https://registry.vetra.io/@powerhousedao/vetra-cloud-package/-/vetra-cloud-package-0.0.75.tgz",
    "@tailwindcss/cli": "^4.1.18",
    "@tmpl/core": "npm:@jsr/tmpl__core@^0.6.3",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "4.1.1",
    "document-model": "catalog:",
    "eslint": "9.39.4",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "graphql": "catalog:",
    "happy-dom": "20.0.10",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "8.3.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.1",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "Powerhouse",
    "url": "https://powerhouse.inc"
  }
}
